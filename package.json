{
  "name": "bmad-manager",
  "version": "0.1.0",
  "description": "A web dashboard to visualize and track BMAD (Breakthrough Method of Agile AI-Driven Development) projects from GitHub repositories.",
  "license": "MIT",
  "author": "Hichem (DevHDI)",
  "homepage": "https://github.com/pouyaSamie/Bmad-Manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/pouyaSamie/Bmad-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/pouyaSamie/Bmad-Manager/issues"
  },
  "keywords": [
    "bmad",
    "dashboard",
    "nextjs",
    "github",
    "agile",
    "project-management",
    "prisma",
    "better-auth"
  ],
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "bmad:worker": "tsx scripts/bmad-worker.ts",
    "agy:gateway": "tsx scripts/cli-gateway.ts --agy",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "codex:gateway": "tsx scripts/cli-gateway.ts",
    "cli:setup": "node scripts/setup-bridge-secrets.mjs",
    "test:cli-containers": "node scripts/verify-cli-containers.mjs",
    "db:migrate-workspace": "tsx scripts/migrate-workspace.ts",
    "test:journey": "tsx scripts/verify-workspace.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@octokit/plugin-retry": "^8.0.3",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.19.2",
    "@tailwindcss/typography": "^0.5.19",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
